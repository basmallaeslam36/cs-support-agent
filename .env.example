# Resource IDs created in your own AWS account (us-east-1).
# These are read with os.environ in main.py - export them in your shell for local runs,
# and pass them to the AgentCore runtime as environment variables when you deploy.
GATEWAY_URL=https://<your-gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
KB_ID=<your-knowledge-base-id>
MEMORY_ID=<your-agentcore-memory-id>
AWS_REGION=us-east-1
